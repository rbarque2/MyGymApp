{
  "hosting": {
    "public": "build/web",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }],
    "headers": [
      {
        "source": "/flutter_service_worker.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/index.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "mygymrapp",
          "appId": "1:98838895021:android:4dadcd0cf354dd2bc12924",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "mygymrapp",
          "appId": "1:98838895021:ios:46db52b7c6eea643c12924",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "mygymrapp",
          "configurations": {
            "android": "1:98838895021:android:4dadcd0cf354dd2bc12924",
            "ios": "1:98838895021:ios:46db52b7c6eea643c12924",
            "web": "1:98838895021:web:713bab9c718b8a22c12924"
          }
        }
      }
    }
  }
}
